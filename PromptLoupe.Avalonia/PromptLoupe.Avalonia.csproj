<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia 版(Windows・Mac・Linux)。開発中。WPF 版(ルートの PromptLoupe.csproj)と同じ機能になるまで、並べて置く。
    共通部分(メタデータの読み取り・設定・タグ辞書)は PromptLoupe.Core を使う。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PromptLoupe</AssemblyName>
    <RootNamespace>PromptLoupe</RootNamespace>
    <ApplicationIcon>../app.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <Product>PromptLoupe</Product>
    <Authors>yuto</Authors>
    <Copyright>Copyright (c) 2026 yuto</Copyright>
    <!-- XAML のバインディングを、コンパイル時に型で確かめる -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Magick.NET の版(パッケージの参照と、ライセンス文の場所の両方で使う) -->
    <MagickNetVersion>15.1.0</MagickNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PromptLoupe.Core/PromptLoupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../app.ico" Link="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 使い方の本文(HelpWindow が読む) -->
    <EmbeddedResource Include="Help.txt" LogicalName="PromptLoupe.Help.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配布物に同梱するライセンス文(ビルド・発行の出力先にコピーする)。
      ルートの THIRD-PARTY-NOTICES.txt は WPF 版用(ModernWpfUI)なので入れず、Avalonia 版用のものを使う。
      パッケージのバージョンを変えたら、THIRD-PARTY-NOTICES.txt も直す
    -->
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Magick.NET と、その中の ImageMagick・libheif などのライセンス文(約 430KB)。パッケージに入っているものをそのまま写す -->
    <None Include="$(NuGetPackageRoot)magick.net-q8-anycpu/$(MagickNetVersion)/Notice.txt" Link="THIRD-PARTY-NOTICES-Magick.NET.txt"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Magick.NET の部品(Magick.Native-*。libheif・libde265(LGPL)を含む)は、単一ファイルの exe に埋め込まず、横に別ファイルで置く。
    LGPL の部分を、利用者が差し替えられるようにするため
  -->
  <Target Name="KeepMagickNativeOutsideBundle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(Filename)').StartsWith('Magick.Native'))"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- 画面の部品。MIT ライセンス。画像の読み込みには、Avalonia に含まれる SkiaSharp を使う -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!--
      HEIC・HEIF・TIFF の読み込み。Apache-2.0(中の libheif・libde265 は LGPL-3.0)。
      Intel の Mac 向けの部品は 15 系で外れ、Apple シリコン向けは macOS 15 以降。それ以外の Mac では HEIC・TIFF を表示できない
    -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="$(MagickNetVersion)" />
  </ItemGroup>

</Project>
