<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia 版(Windows・Mac・Linux)。開発中。WPF 版(ルートの PromptLoupe.csproj)と同じ機能になるまで、並べて置く。
    共通部分(メタデータの読み取り・設定・タグ辞書)は PromptLoupe.Core を使う。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PromptLoupe</AssemblyName>
    <RootNamespace>PromptLoupe</RootNamespace>
    <ApplicationIcon>../app.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <Product>PromptLoupe</Product>
    <Authors>yuto</Authors>
    <Copyright>Copyright (c) 2026 yuto</Copyright>
    <!-- XAML のバインディングを、コンパイル時に型で確かめる -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- HEIC を OS の機能(Windows の WIC、Mac の ImageIO、Linux の libheif)で読むところで、ポインターを使う(HeifLoader.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PromptLoupe.Core/PromptLoupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../app.ico" Link="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 使い方の本文(HelpWindow が読む) -->
    <EmbeddedResource Include="Help.txt" LogicalName="PromptLoupe.Help.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ライセンス文。exe に埋め込み、アプリの「ヘルプ → ライセンス」で表示する(LicenseWindow)。配布物は exe だけにするため。
      ルートの THIRD-PARTY-NOTICES.txt は WPF 版用(ModernWpfUI)なので使わず、Avalonia 版用のものを使う。
      パッケージを足したり、バージョンを変えたりしたら、THIRD-PARTY-NOTICES.txt も直す
    -->
    <EmbeddedResource Include="../LICENSE" LogicalName="PromptLoupe.LICENSE.txt" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="PromptLoupe.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- 画面の部品。MIT ライセンス。画像の読み込みには、Avalonia に含まれる SkiaSharp を使う -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!--
      TIFF の読み込み(どの OS でも)。C# だけで書かれているので exe に入る。BSD ライセンス。
      HEIC は同梱の部品を使わず、OS の機能で読む(HeifLoader.cs)。HEVC のデコーダーは LGPL などで、exe に入れられないため
    -->
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
  </ItemGroup>

</Project>
