<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PromptLoupe</AssemblyName>
    <RootNamespace>PromptLoupe</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <Product>PromptLoupe</Product>
    <Authors>yuto</Authors>
    <Copyright>Copyright (c) 2026 yuto</Copyright>
    <!-- ModernWpfUI の翻訳ファイルは、日本語だけを出力する(英語は本体に入っている。ほかの約 60 言語は入れない) -->
    <SatelliteResourceLanguages>ja-JP</SatelliteResourceLanguages>
    <!-- 共通部分とテストは別のプロジェクト。この画面のプロジェクトには含めない -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PromptLoupe.Core/**;PromptLoupe.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- OS に依存しない共通部分(メタデータの読み取り・設定・タグ辞書) -->
    <ProjectReference Include="PromptLoupe.Core/PromptLoupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配布物に同梱するライセンス文(ビルド・発行の出力先にコピーする) -->
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows 11 風のデザイン(ダーク/ライト対応)。MIT ライセンス -->
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

</Project>
