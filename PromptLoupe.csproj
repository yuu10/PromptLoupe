<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PromptLoupe</AssemblyName>
    <RootNamespace>PromptLoupe</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <Product>PromptLoupe</Product>
    <Authors>yuto</Authors>
    <Copyright>Copyright (c) 2026 yuto</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配布物に同梱するライセンス文(ビルド・発行の出力先にコピーする) -->
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows 11 風のデザイン(ダーク/ライト対応)。MIT ライセンス -->
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

</Project>
