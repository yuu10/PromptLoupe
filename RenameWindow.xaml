<Window x:Class="MViewer.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="名前の変更" Icon="app.ico" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="新しいファイル名" />
        <DockPanel Margin="0,8,0,0">
            <TextBlock x:Name="ExtText" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBox x:Name="NameBox" />
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#E5484D" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="88" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="88" />
        </StackPanel>
    </StackPanel>
</Window>
