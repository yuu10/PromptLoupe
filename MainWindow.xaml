<Window x:Class="MViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="M Viewer" Icon="app.ico" Width="1400" Height="840" MinWidth="900" MinHeight="520"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- ───── 共通スタイル ───── -->

        <!-- 右パネルのカード -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- カードの見出し -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- カードの見出しを兼ねる、最小化 / 展開のボタン(枠も背景もない見た目) -->
        <Style x:Key="SectionToggle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 補足の文字(薄い色) -->
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <!-- カードの中の小さなボタン -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- 枠も背景もない、選択してコピーできる文字 -->
        <Style x:Key="PlainText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <!-- 独自のスタイルなので、文字色もここで指定する(指定しないと、ダークでも黒のままで読めない) -->
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- パラメーターの1行(名前 + 値) -->
        <DataTemplate x:Key="ParamRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Key}" VerticalAlignment="Top" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource PlainText}" />
            </Grid>
        </DataTemplate>

        <!-- ───── 一覧の項目 ───── -->

        <!-- サムネイルなし -->
        <DataTemplate x:Key="TextItemTemplate">
            <StackPanel Margin="2,3">
                <TextBlock Text="{Binding Display}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" FontSize="11" Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- サムネイルあり(大きさは設定で変わる ThumbSize を参照) -->
        <DataTemplate x:Key="ThumbItemTemplate">
            <DockPanel Margin="2,3">
                <Border DockPanel.Dock="Left" Width="{DynamicResource ThumbSize}" Height="{DynamicResource ThumbSize}"
                        CornerRadius="4" ClipToBounds="True" Background="#2A2A2A">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Display}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="11" Style="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───── メニュー ───── -->
        <Menu x:Name="MainMenu" Grid.Row="0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="フォルダを開く(_O)..." Click="OpenFolder_Click" />
                <MenuItem Header="画像を開く(_I)..." Click="OpenFile_Click" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="全画面表示(_F)" InputGestureText="F11" Click="Fullscreen_Click" />
                <MenuItem Header="タグの集計(_T)..." InputGestureText="Ctrl+T" Click="TagStats_Click" />
            </MenuItem>
            <MenuItem Header="設定(_S)">
                <MenuItem x:Name="ThemeMenu" Header="テーマ(_H)">
                    <MenuItem Header="Windows の設定に合わせる" Tag="System" IsCheckable="True" Click="Theme_Click" />
                    <MenuItem Header="ダーク" Tag="Dark" IsCheckable="True" Click="Theme_Click" />
                    <MenuItem Header="ライト" Tag="Light" IsCheckable="True" Click="Theme_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ThumbMenu" Header="サムネイルを表示(_T)"
                          IsCheckable="True" Click="Thumb_Click" />
                <MenuItem x:Name="ThumbSizeMenu" Header="サムネイルの大きさ(_Z)">
                    <MenuItem Header="小" Tag="48" IsCheckable="True" Click="ThumbSize_Click" />
                    <MenuItem Header="中" Tag="64" IsCheckable="True" Click="ThumbSize_Click" />
                    <MenuItem Header="大" Tag="96" IsCheckable="True" Click="ThumbSize_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="SubfolderMenu" Header="サブフォルダの読み込み(_R)">
                    <MenuItem Header="含めない" Tag="0" IsCheckable="True" Click="SubfolderDepth_Click" />
                    <MenuItem Header="1階層まで" Tag="1" IsCheckable="True" Click="SubfolderDepth_Click" />
                    <MenuItem Header="2階層まで" Tag="2" IsCheckable="True" Click="SubfolderDepth_Click" />
                    <MenuItem Header="3階層まで" Tag="3" IsCheckable="True" Click="SubfolderDepth_Click" />
                    <MenuItem Header="無制限" Tag="-1" IsCheckable="True" Click="SubfolderDepth_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="ファイル操作(_D)">
                    <MenuItem x:Name="AllowDeleteMenu" Header="削除を許可する" IsCheckable="True" Click="AllowDelete_Click"
                              ToolTip="オフのあいだは、削除の操作ができません(誤って消さないための安全装置)" />
                    <MenuItem x:Name="ConfirmDeleteMenu" Header="削除の前に確認する" IsCheckable="True" Click="ConfirmDelete_Click" />
                </MenuItem>
                <MenuItem Header="タグの色分け(_G)">
                    <MenuItem x:Name="TagColorMenu" Header="色分けする" IsCheckable="True" Click="TagColor_Click" />
                    <Separator />
                    <MenuItem Header="タグ辞書(danbooru.csv)を読み込む..." Click="LoadTagDict_Click" />
                    <MenuItem Header="タグ辞書を外す" Click="RemoveTagDict_Click" />
                    <Separator />
                    <MenuItem x:Name="TagDictStatus" Header="辞書: 未読み込み" IsEnabled="False" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="使い方(_M)..." InputGestureText="F1" Click="Help_Click" />
                <Separator />
                <MenuItem Header="バージョン情報(_A)..." Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ───── 絞り込み(ウィンドウの右端まで伸ばす) ───── -->
        <Grid x:Name="FilterRow" Grid.Row="1" Margin="10,6,10,6">
            <!-- 「検索対象」ボタンを左に置いて、検索窓がウィンドウの右端まで届くようにする -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="1" HorizontalAlignment="Stretch"
                     ui:ControlHelper.PlaceholderText="語句をカンマ区切りで入力(例: blue hair, 1girl)"
                     ui:TextBoxHelper.IsDeleteButtonVisible="True"
                     ToolTip="語句をカンマ( , )で区切ると、すべてを含む画像だけを表示します(AND)。&#10;例: blue hair, 1girl&#10;スペースと _ は同じ扱いです(hatsune miku = hatsune_miku)。&#10;検索する項目は左の「検索対象」ボタンで変更できます。"
                     TextChanged="Filter_Changed" />
            <Button x:Name="FilterTargetButton" Grid.Column="0" Content="検索対象 ▾" Margin="0,0,8,0"
                    ToolTip="絞り込みで検索する項目を選択" Click="FilterTarget_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="FilterTargetMenu">
                        <MenuItem x:Name="TgtFileName" Header="ファイル名" IsCheckable="True"
                                  StaysOpenOnClick="True" Click="FilterTarget_Changed" />
                        <MenuItem x:Name="TgtPrompt" Header="プロンプト" IsCheckable="True"
                                  StaysOpenOnClick="True" Click="FilterTarget_Changed" />
                        <MenuItem x:Name="TgtNegative" Header="ネガティブプロンプト" IsCheckable="True"
                                  StaysOpenOnClick="True" Click="FilterTarget_Changed" />
                        <MenuItem x:Name="TgtCharacters" Header="キャラクター別プロンプト" IsCheckable="True"
                                  StaysOpenOnClick="True" Click="FilterTarget_Changed" />
                        <MenuItem x:Name="TgtCharacterNegative" Header="キャラクター別ネガティブ" IsCheckable="True"
                                  StaysOpenOnClick="True" Click="FilterTarget_Changed" />
                        <MenuItem x:Name="TgtModel" Header="モデル名" IsCheckable="True"
                                  StaysOpenOnClick="True" Click="FilterTarget_Changed" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="330" MinWidth="220" />
                <ColumnDefinition x:Name="SplitCol1" Width="6" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition x:Name="SplitCol2" Width="6" />
                <ColumnDefinition x:Name="RightCol" Width="390" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ───── 左: 絞り込み・並び替え・一覧 ───── -->
            <Grid x:Name="LeftPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 並び替え -->
                <Grid Grid.Row="0" Margin="10,2,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="並び替え" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SortBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"
                              SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="ファイル名" Tag="Name" />
                        <ComboBoxItem Content="更新日時" Tag="Modified" />
                        <ComboBoxItem Content="サイズ" Tag="Size" />
                        <ComboBoxItem Content="モデル" Tag="Model" />
                        <ComboBoxItem Content="サンプラー" Tag="Sampler" />
                        <ComboBoxItem Content="ステップ数" Tag="Steps" />
                        <ComboBoxItem Content="CFG" Tag="Cfg" />
                    </ComboBox>
                    <ToggleButton x:Name="DescBox" Grid.Column="2" Content="▲ 昇順" MinWidth="76" Margin="6,0,0,0"
                                  ToolTip="クリックで昇順(▲)と降順(▼)を切り替え"
                                  Checked="Sort_Changed" Unchecked="Sort_Changed" />
                </Grid>

                <!-- ファイル一覧 -->
                <ListBox x:Name="FileList" Grid.Row="1" SelectionChanged="FileList_SelectionChanged"
                         SelectionMode="Extended"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                         PreviewMouseMove="FileList_PreviewMouseMove"
                         ContextMenuOpening="FileList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="FileMenu">
                            <MenuItem x:Name="FmOpen" Header="既定のアプリで開く(_O)" Click="FileOp_OpenDefault" />
                            <MenuItem x:Name="FmExplorer" Header="エクスプローラーで開く(_E)" Click="FileOp_Explorer" />
                            <Separator />
                            <MenuItem x:Name="FmCut" Header="切り取り(_T)" InputGestureText="Ctrl+X" Click="FileOp_Cut" />
                            <MenuItem x:Name="FmCopy" Header="コピー(_C)" InputGestureText="Ctrl+C" Click="FileOp_Copy" />
                            <MenuItem x:Name="FmPaste" Header="貼り付け(_V)" InputGestureText="Ctrl+V" Click="FileOp_Paste" />
                            <Separator />
                            <MenuItem x:Name="FmRename" Header="名前の変更(_M)" InputGestureText="F2" Click="FileOp_Rename" />
                            <MenuItem x:Name="FmDelete" Header="削除(_D)" InputGestureText="Delete" Click="FileOp_Delete" />
                            <Separator />
                            <MenuItem x:Name="FmCopyPath" Header="ファイルのパスをコピー(_P)" InputGestureText="Ctrl+Shift+C" Click="FileOp_CopyPath" />
                            <MenuItem x:Name="FmCopyImage" Header="画像をコピー(_I)" Click="FileOp_CopyImage" />
                            <MenuItem x:Name="FmCopyPrompt" Header="プロンプトをコピー(_R)" Click="FileOp_CopyPrompt" />
                            <Separator />
                            <MenuItem x:Name="FmProps" Header="プロパティ(_A)" InputGestureText="Alt+Enter" Click="FileOp_Properties" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <GridSplitter x:Name="Split1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ───── 中央: 画像表示 ───── -->
            <Grid x:Name="Viewport" Grid.Column="2" Background="#1B1B1B" ClipToBounds="True"
                  MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown"
                  MouseLeftButtonUp="Viewport_MouseUp" MouseMove="Viewport_MouseMove"
                  SizeChanged="Viewport_SizeChanged">
                <Image x:Name="Img" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Scale" />
                            <TranslateTransform x:Name="Trans" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- 画像がないときの案内 -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="Placeholder" Foreground="#9A9A9A" FontSize="16" TextAlignment="Center"
                               Text="フォルダまたは画像をドラッグ&amp;ドロップ" />
                    <Button Content="フォルダを開く" Click="OpenFolder_Click" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="18,6" />
                </StackPanel>

                <!-- 表示倍率とフィット/100%(画像の右下に重ねる) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                        CornerRadius="8" Background="#CC262626" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ZoomText" Foreground="#DDDDDD" VerticalAlignment="Center"
                                   MinWidth="48" TextAlignment="Right" Margin="6,0,10,0"
                                   ToolTip="現在の表示倍率" />
                        <Button x:Name="FitButton" Content="フィット" Style="{StaticResource SmallButton}"
                                Click="Fit_Click" Margin="0,0,4,0"
                                ToolTip="フィット表示(F)。画像を切り替えてもこの表示が続きます(選択中は太字)" />
                        <Button x:Name="ActualButton" Content="100%" Style="{StaticResource SmallButton}"
                                Click="Actual_Click"
                                ToolTip="等倍表示(1)。画像を切り替えてもこの表示が続きます(選択中は太字)" />
                        <Button x:Name="FullscreenButton" Content="全画面" Style="{StaticResource SmallButton}"
                                Click="Fullscreen_Click" Margin="4,0,0,0"
                                ToolTip="全画面表示(F11)。Esc で戻ります" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="Split2" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ───── 右: メタデータ(カード) ───── -->
            <ScrollViewer x:Name="RightPanel" Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,8,12,8">

                    <!-- ファイル / 生成元 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ファイル" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                            <TextBlock x:Name="FileInfoText" TextWrapping="Wrap" />
                            <TextBlock Text="生成元" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                            <TextBlock x:Name="SourceText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- プロンプト -->
                    <Border x:Name="PromptCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="コピー" Style="{StaticResource SmallButton}"
                                        Click="CopyPrompt_Click" />
                                <Button Style="{StaticResource SectionToggle}" Tag="Prompt" Click="Section_Toggle"
                                        ToolTip="クリックで最小化 / 展開">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PromptArrow" Text="▾" Style="{StaticResource SectionHeader}" Width="16" />
                                        <TextBlock Text="プロンプト(タグをクリックで絞り込みに追加)" Style="{StaticResource SectionHeader}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <StackPanel x:Name="PromptBody" Margin="0,8,0,0">
                                <WrapPanel x:Name="PromptChips" />
                                <Expander Header="全文を表示" Margin="0,6,0,0">
                                    <TextBox x:Name="PromptBox" Style="{StaticResource PlainText}" Margin="0,6,0,0"
                                             MaxHeight="240" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ネガティブプロンプト -->
                    <Border x:Name="NegativeCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="コピー" Style="{StaticResource SmallButton}"
                                        Click="CopyNegative_Click" />
                                <Button Style="{StaticResource SectionToggle}" Tag="Negative" Click="Section_Toggle"
                                        ToolTip="クリックで最小化 / 展開">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="NegativeArrow" Text="▾" Style="{StaticResource SectionHeader}" Width="16" />
                                        <TextBlock Text="ネガティブプロンプト" Style="{StaticResource SectionHeader}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <StackPanel x:Name="NegativeBody" Margin="0,8,0,0">
                                <WrapPanel x:Name="NegativeChips" />
                                <Expander Header="全文を表示" Margin="0,6,0,0">
                                    <TextBox x:Name="NegativeBox" Style="{StaticResource PlainText}" Margin="0,6,0,0"
                                             MaxHeight="200" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- キャラクター別プロンプト(NovelAI V4 など。該当する画像のみ) -->
                    <Border x:Name="CharactersCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Button Style="{StaticResource SectionToggle}" Tag="Characters" Click="Section_Toggle"
                                    ToolTip="クリックで最小化 / 展開">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CharactersArrow" Text="▾" Style="{StaticResource SectionHeader}" Width="16" />
                                    <TextBlock Text="キャラクター別プロンプト" Style="{StaticResource SectionHeader}" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="CharactersPanel" />
                        </StackPanel>
                    </Border>

                    <!-- パラメーター -->
                    <Border x:Name="ParamsCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <Button Style="{StaticResource SectionToggle}" Tag="Params" Click="Section_Toggle"
                                    ToolTip="クリックで最小化 / 展開">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ParamsArrow" Text="▾" Style="{StaticResource SectionHeader}" Width="16" />
                                    <TextBlock Text="パラメーター" Style="{StaticResource SectionHeader}" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="ParamsBody" Margin="0,6,0,0">
                                <ItemsControl x:Name="ParamsList" ItemTemplate="{StaticResource ParamRow}" />
                                <Expander x:Name="OtherExpander" Header="その他のパラメーター" Margin="0,6,0,0"
                                          Visibility="Collapsed">
                                    <ItemsControl x:Name="OtherParamsList" ItemTemplate="{StaticResource ParamRow}"
                                                  Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 生のメタデータ -->
                    <Border Style="{StaticResource Card}">
                        <Expander Header="生のメタデータ">
                            <TextBox x:Name="RawBox" Style="{StaticResource PlainText}" Margin="0,6,0,0"
                                     MaxHeight="340" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ───── ステータスバー ───── -->
        <Border x:Name="StatusBar" Grid.Row="3" Padding="12,5"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
                <TextBlock x:Name="Status" Text="準備完了" Style="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
