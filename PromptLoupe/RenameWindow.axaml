<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PromptLoupe.RenameWindow"
        Title="名前の変更" Icon="avares://PromptLoupe/Assets/app.ico"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="新しいファイル名" />
        <DockPanel Margin="0,8,0,0">
            <TextBlock x:Name="ExtText" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBox x:Name="NameBox" />
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#E5484D" Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" Spacing="8">
            <Button Content="OK" IsDefault="True" MinWidth="88" HorizontalContentAlignment="Center" Click="Ok_Click" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="88" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
