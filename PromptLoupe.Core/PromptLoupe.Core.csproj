<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OS に依存しない共通部分(メタデータの読み取り、設定、タグ辞書、プロンプトの分割)。
    WPF を使わないので、Linux・Mac でもビルドとテストができる。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PromptLoupe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PromptLoupe.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 書庫(zip・rar・7z)の読み込み。MIT License(RAR の展開部分は UnRAR のソースから移したもの。THIRD-PARTY-NOTICES.txt を参照) -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

</Project>
